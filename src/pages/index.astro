---
import BaseLayout from '@/layouts/BaseLayout.astro'
import ExperienceSection from '@/components/ExperienceSection.vue'
import SkillsSection from '@/components/SkillsSection.vue'
import ProjectsSection from '@/components/ProjectsSection.vue'
import siteConfig from '@/site-config'
import { experience, skills, projects } from '@/portfolio-data'
---

<BaseLayout description={siteConfig.description}>
  <div class="flex-col justify-items-center gap-6 !pt-0 mb-4">
    <h1 class="text-5xl text-title font-600 mb-3">Osempu</h1>
    <div class="font-800 flex align-items-center justify-items-center text-zinc-700 dark:text-zinc-300">
      <span class="mr-3">Software Engineer</span>
      <span class="ml-3 mr-3">AI Development</span>
      <span class="ml-3">Web Developer</span>
    </div>
    <div class="my-10">
      <p class="text-lg text-zinc-700 dark:text-zinc-300">
        I'm a software engineer that enjoys building creative solutions and exploring new technologies to solve problems
        in creative ways, I love to recreate the wheel for learning purposes and to understand how things work deeply
        under the hood, I have experience as a software engineer working in both backend and frontend technologies
      </p>
    </div>
  </div>

  <ExperienceSection client:load items={experience} />

  <SkillsSection client:load categories={skills} />

  <ProjectsSection client:load projects={projects} />

  <hr class="hr-line" />
  <p>Find me on</p>
  <p class="flex gap-x-4 gap-y-2 flex-wrap">
    {
      siteConfig.socialLinks.map((link) => (
        <a aria-label={link.text} href={link.href} target="_blank" class="prose-link">
          <i class:list={[link.icon]} />
          {link.text}
        </a>
      ))
    }
  </p>
  <p>
    If you have any questions, please email me at
    <a prose-link aria-label={siteConfig.email} href={`mailto:${siteConfig.email}`}>
      {siteConfig.email}
    </a>.
  </p>
</BaseLayout>
